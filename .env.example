# ==============================================================================
# STUDENT-SKY ENVIRONMENT VARIABLES
# ==============================================================================

# NEXT.JS & APP URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SUPABASE CONFIGURATION (จาก Supabase Project "student-sky" ใหม่)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# GCC CANVAS LMS CONFIGURATION
# Glendale Community College Canvas base URL
CANVAS_BASE_URL=https://glendale.instructure.com
# GCC Canvas Personal Access Token (สร้างจาก Account > Settings > Approved Integrations)
CANVAS_API_TOKEN=your_gcc_canvas_api_token_here

# VERCEL CRON & SYNC SECURITY SECRET
# Bearer token สำหรับป้องกันไม่ให้คนอื่นเรียก /api/cron หรือ /api/sync/canvas โดยไม่ได้รับอนุญาต
CRON_SECRET=your_random_secure_cron_secret_string
